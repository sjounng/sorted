{
  "manifest_version": 3,
  "name": "Sorted",
  "version": "0.2.0",
  "description": "LMS에서 받은 강의자료를 Sorted 앱으로 넘겨 과목·주차별로 정리합니다.",
  "key": "",
  "permissions": ["nativeMessaging", "downloads", "storage"],
